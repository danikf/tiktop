<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>tiktop</RootNamespace>
    <AssemblyName>tiktop</AssemblyName>
    <Nullable>enable</Nullable>
    <Version>0.9.0</Version>
    <Authors>danikf</Authors>
    <Copyright>Copyright © 2025–2026 Daniel Frantík</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Mikrotik version of famous iftop tool</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/danikf/tiktop</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Single-file publish settings (activated via -p:PublishSingleFile=true) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trimming off: tik4net and DnsClient rely on reflection -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Local development: use tik4net source for live editing -->
  <ItemGroup Condition="'$(CI)' != 'true'">
    <ProjectReference Include="..\..\..\tik4net\tik4net\tik4net\tik4net.csproj" />
    <ProjectReference Include="..\..\..\tik4net\tik4net\tik4net.objects\tik4net.objects.csproj" />
  </ItemGroup>
  <!-- CI / standalone build: use published NuGet packages -->
  <ItemGroup Condition="'$(CI)' == 'true'">
    <PackageReference Include="tik4net" Version="3.6.0" />
    <PackageReference Include="tik4net.entities" Version="3.6.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
